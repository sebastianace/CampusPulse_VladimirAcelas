    {
      "parameters": {
        "jsCode": "// Valida el webhook que envía Campus Pulse: firma HMAC-SHA256, antigüedad del mensaje y forma de los datos.\nconst crypto = require('crypto');\nconst AREAS = ['Infraestructura', 'Soporte TI', 'Servicios generales', 'Seguridad', 'Bienestar'];\nconst PRIORIDADES = ['baja', 'media', 'alta', 'critica'];\nconst TOLERANCIA_SEGUNDOS = 300;\n\nconst rechazar = (motivo) => [{ json: { valido: false, motivo } }];\n\nconst secreto = $env.N8N_SECRETO;\nif (!secreto) return rechazar('El secreto N8N_SECRETO no está configurado en n8n.');\n\nconst cabeceras = $input.first().json.headers ?? {};\nconst firma = cabeceras['x-pulse-firma'];\nconst marca = cabeceras['x-pulse-timestamp'];\nif (!firma || !marca) return rechazar('Faltan las cabeceras de firma.');\n\n// La firma se calcula sobre el cuerpo EXACTO que se envió (por eso el webhook guarda el cuerpo crudo).\nlet crudo;\ntry {\n  crudo = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\n} catch (error) {\n  return rechazar('No llegó el cuerpo de la petición.');\n}\n\nconst esperada = Buffer.from('sha256=' + crypto.createHmac('sha256', secreto).update(`${marca}.${crudo}`).digest('hex'));\nconst recibida = Buffer.from(String(firma));\nif (esperada.length !== recibida.length || !crypto.timingSafeEqual(esperada, recibida)) return rechazar('Firma inválida.');\n\nconst edad = Math.abs(Math.floor(Date.now() / 1000) - Number(marca));\nif (!Number.isFinite(edad) || edad > TOLERANCIA_SEGUNDOS) return rechazar('El mensaje es demasiado viejo o viene del futuro.');\n\nlet datos;\ntry { datos = JSON.parse(crudo); } catch (error) { return rechazar('El cuerpo no es JSON.'); }\nconst i = datos?.incidencia;\nif (datos?.evento !== 'incidencia.creada' || typeof i?.id !== 'string' || !AREAS.includes(i?.area) || !PRIORIDADES.includes(i?.prioridad)) {\n  return rechazar('Los datos de la incidencia no tienen el formato esperado.');\n}\nreturn [{ json: { valido: true, incidencia: i } }];\n"
      },
