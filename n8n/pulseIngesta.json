{
  "id": "pulseIngesta",
  "name": "Pulse · Ingesta de documentos (embebidos)",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "formTitle": "Subir un documento a la base de conocimiento de Pulse",
        "formDescription": "Sube un archivo .md o .txt. n8n lo parte en fragmentos, calcula sus embeddings con Gemini y los guarda en PostgreSQL (pgvector).",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Documento",
              "fieldType": "file",
              "multipleFiles": false,
              "acceptFileTypes": ".md,.txt",
              "requiredField": true
            }
          ]
        },
        "options": {
          "path": "ingesta-conocimiento"
        }
      },
      "id": "88a03a46-bb00-4c0a-a1b9-d9dc1d882c2f",
      "name": "Formulario: subir documento",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ],
      "webhookId": "5c8f13f6-0e8b-4119-822e-895ce8eb0ffc"
    },
    {
      "parameters": {
        "operation": "text",
        "binaryPropertyName": "Documento",
        "options": {}
      },
      "id": "2ebc19d1-c86c-46e8-a465-fcb426032f23",
      "name": "Extraer el texto",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "307b78f1-4fa2-4a21-8da6-c2e93d9b0112",
              "name": "archivo",
              "value": "={{ $('Formulario: subir documento').item.binary.Documento.fileName }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "3c24b0f1-9886-45b8-b217-df1b1b912809",
      "name": "Nombre del archivo",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        460,
        0
      ]
    },
    {
      "parameters": {
        "mode": "insert",
        "tableName": "n8n_conocimiento",
        "options": {
          "distanceStrategy": "cosine"
        }
      },
      "id": "1579a184-55ec-446a-8baa-aaa0ea62b574",
      "name": "Guardar en PGVector",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePGVector",
      "typeVersion": 1.3,
      "position": [
        700,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "pulse-postgres",
          "name": "Pulse PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "dataType": "json",
        "jsonMode": "expressionData",
        "jsonData": "={{ $json.data }}",
        "textSplittingMode": "custom",
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "archivo",
                "value": "={{ $json.archivo }}"
              }
            ]
          }
        }
      },
      "id": "17d79930-2282-4168-bd7e-8854372dd03d",
      "name": "Cargar documento",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [
        760,
        240
      ]
    },
    {
      "parameters": {
        "chunkSize": 700,
        "chunkOverlap": 80,
        "options": {}
      },
      "id": "6ece74a6-28a4-49b2-b5c7-dfa86ee934f7",
      "name": "Partir en fragmentos",
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [
        760,
        440
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-embedding-001"
      },
      "id": "dae48d0d-ffec-4ea9-8b2e-cd9954df9670",
      "name": "Embeddings de Gemini",
      "type": "@n8n/n8n-nodes-langchain.embeddingsGoogleGemini",
      "typeVersion": 1,
      "position": [
        560,
        240
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "pulse-gemini",
          "name": "Pulse Gemini"
        }
      }
    }
  ],
