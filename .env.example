GEMINI_API_KEY=
GEMINI_MODEL=
PORT=3000
# Base de datos (PostgreSQL con docker compose). Elige tu propia contraseña y no la subas al repositorio.
POSTGRES_PASSWORD=
POSTGRES_PUERTO=5433

# Servicio de conocimiento (RAG, pulse-ai). Con `docker compose up -d --build` ya queda conectado.
# Si corres Express con `npm run dev`, apunta al puerto publicado por compose.
PULSE_AI_URL=http://localhost:8000
PULSE_AI_PUERTO=8000
# Opcional: secreto compartido entre Express y pulse-ai (pon el mismo valor en los dos; en compose basta con definirlo aquí).
PULSE_AI_TOKEN=

# Automatización con n8n (ver docs/workflows.md). N8N_SECRETO es un texto largo y aleatorio, el mismo para Campus Pulse
# y n8n:  openssl rand -hex 24   Sin él la integración queda apagada.
N8N_SECRETO=
# Solo si corres Express con `npm run dev` (en Docker compose ya lo configura):
N8N_WEBHOOK_URL=http://localhost:5678/webhook/incidencia-nueva

# RAG: reranking de los fragmentos con Gemini. 0 (por defecto) = apagado: ahorra una llamada y ~1.4 s por pregunta sin
# perder exactitud medida (docs/evaluacion-rag.md). 1 = encendido.
RAG_RERANKING=0
